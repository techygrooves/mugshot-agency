---
/**
 * Every page renders through this layout, so every page gets the same SEO
 * baseline: a unique <title>, meta description, canonical URL, Open Graph /
 * Twitter tags with a share image, icons, and Organization structured data.
 */
import '../styles/global.css';
import { site } from '@config/site';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
// Body text font, latin subset: preloaded so text renders in the brand font without a late swap.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description: string;
  /** Extra JSON-LD objects for this page (Service, FAQPage, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
  /** Force noindex for pages not listed in site.noindexPaths (e.g. unreviewed state pages). */
  noindex?: boolean;
  /** Open Graph type: 'article' for resource articles. */
  ogType?: 'website' | 'article';
  /** Share image path under public/ (1200×630). */
  image?: { src: string; alt: string };
}

const {
  title,
  description,
  schema = [],
  noindex: forceNoindex = false,
  ogType = 'website',
  image = { src: '/og-default.png', alt: `${site.name} — online reputation management in all 50 states` },
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Online Reputation Management`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const noindex = forceNoindex || site.noindexPaths.includes(Astro.url.pathname);

const imageUrl = new URL(image.src, site.url).href;
const isHome = Astro.url.pathname === '/';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: new URL('/logo.png', site.url).href,
  description: site.description,
  areaServed: { '@type': 'Country', name: 'United States' },
};
// WebSite on the home page helps Google show the site name in results.
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, publisher: { '@id': organization['@id'] } };
const jsonLd = [organization, ...(isHome ? [website] : []), ...schema.map((s) => ({ '@context': 'https://schema.org', ...s }))];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Resources`} href="/resources/rss.xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b1b33" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
