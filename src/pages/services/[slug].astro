---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import FaqList from '@components/FaqList.astro';
import CtaBand from '@components/CtaBand.astro';
import ServiceCard from '@components/ServiceCard.astro';
import Icon from '@components/Icon.astro';
import { site, cta } from '@config/site';
import { services, type Service } from '@data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const url = new URL(`/services/${service.slug}/`, Astro.site).href;
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

const schema = [
  {
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.metaDescription,
    url,
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    areaServed: { '@type': 'Country', name: 'United States' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Services', item: new URL('/services/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: service.name, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout title={service.title} description={service.metaDescription} schema={schema}>
  <PageHero
    eyebrow="Service"
    title={service.name}
    lead={service.summary}
    crumbs={[{ label: 'Services', href: '/services/' }, { label: service.name, href: `/services/${service.slug}/` }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={cta.href} class="btn-primary">{cta.label}</a>
    </div>
  </PageHero>

  <section class="py-16 md:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="prose-body text-lg lg:col-span-7">
        {service.intro.map((p) => <p>{p}</p>)}
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-2xl border border-navy-100 bg-navy-50 p-7">
          <h2 class="text-lg font-bold">This service can help if…</h2>
          <ul class="mt-4 space-y-3">
            {service.problems.map((p) => (
              <li class="flex gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" /><span>{p}</span></li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-navy-50 py-16 md:py-20">
    <div class="container-x">
      <p class="eyebrow">Our approach</p>
      <h2 class="mt-3 text-3xl font-extrabold">How we handle it</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {service.approach.map((step, i) => (
          <li class="rounded-2xl border border-navy-100 bg-white p-6">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-navy-900 font-display text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl font-extrabold">What’s included</h2>
        <ul class="mt-6 space-y-3">
          {service.includes.map((item) => (
            <li class="flex gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" /><span>{item}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-slate-500">Scope is tailored to each client. Results vary and are not guaranteed.</p>
      </div>
      <div class="lg:col-span-7">
        <h2 class="text-3xl font-extrabold">Frequently asked questions</h2>
        <div class="mt-6"><FaqList faqs={service.faqs} /></div>
      </div>
    </div>
  </section>

  <section class="bg-navy-50 py-16">
    <div class="container-x">
      <h2 class="text-2xl font-extrabold">Related services</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
