---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import CtaBand from '@components/CtaBand.astro';
import Icon from '@components/Icon.astro';
import { categoryLabels } from '@data/resource-categories';
import { RESOURCE_CATEGORIES } from '../../content.config';

const articles = (await getCollection('resources')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.data.title.localeCompare(b.data.title),
);
const groups = RESOURCE_CATEGORIES.map((category) => ({ category, items: articles.filter((a) => a.data.category === category) })).filter((g) => g.items.length > 0);
---
<BaseLayout
  title="Reputation Management Guides"
  description="Practical guides to removing mugshots, cleaning up search results and protecting your personal information online, from National Reputation Defense."
  schema={[{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Resources', item: new URL('/resources/', Astro.site).href }] }]}
>
  <PageHero
    eyebrow="Resources"
    title="Guides to taking back your online reputation"
    lead="Plain-English explanations of how removal, suppression and privacy protection work — including the steps you can take yourself."
    crumbs={[{ label: 'Resources', href: '/resources/' }]}
  />
  <nav aria-label="Guide topics" class="border-b border-navy-100 bg-white">
    <ul class="container-x flex gap-2 overflow-x-auto py-4">
      {groups.map((g) => (
        <li><a href={`#${g.category}`} class="inline-block whitespace-nowrap rounded-full border border-navy-100 px-4 py-2 text-sm font-medium text-ink hover:border-accent-500">{categoryLabels[g.category]} <span class="text-slate-500">({g.items.length})</span></a></li>
      ))}
    </ul>
  </nav>
  {groups.map((g, i) => (
    <section id={g.category} class:list={['scroll-mt-24 py-14 md:py-16', i % 2 === 0 && 'bg-navy-50']}>
      <div class="container-x">
        <h2 class="text-2xl font-extrabold md:text-3xl">{categoryLabels[g.category]}</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {g.items.map((a) => (
            <a href={`/resources/${a.id}/`} class="group flex flex-col rounded-2xl border border-navy-100 bg-white p-6 transition hover:border-accent-500 hover:shadow-lg hover:shadow-navy-900/5">
              <h3 class="text-lg font-bold">{a.data.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed">{a.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700">Read guide <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBand />
</BaseLayout>
