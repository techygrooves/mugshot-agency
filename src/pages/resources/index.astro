---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import CtaBand from '@components/CtaBand.astro';
import Icon from '@components/Icon.astro';
import { categoryLabels } from '@data/resource-categories';

const articles = (await getCollection('resources')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout
  title="Reputation Management Guides"
  description="Practical guides to removing mugshots, cleaning up search results and protecting your personal information online, from National Reputation Defense."
  schema={[{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Resources', item: new URL('/resources/', Astro.site).href }] }]}
>
  <PageHero
    eyebrow="Resources"
    title="Guides to taking back your online reputation"
    lead="Plain-English explanations of how removal, suppression and privacy protection work — including the steps you can take yourself."
    crumbs={[{ label: 'Resources', href: '/resources/' }]}
  />
  <section class="bg-navy-50 py-16 md:py-20">
    <div class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((a) => (
        <a href={`/resources/${a.id}/`} class="group flex flex-col rounded-2xl border border-navy-100 bg-white p-7 transition hover:-translate-y-0.5 hover:border-accent-500 hover:shadow-lg hover:shadow-navy-900/5">
          <span class="eyebrow text-xs">{categoryLabels[a.data.category]}</span>
          <h2 class="mt-3 text-xl font-bold">{a.data.title}</h2>
          <p class="mt-3 flex-1 text-[15px] leading-relaxed">{a.data.description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700">Read guide <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</BaseLayout>
