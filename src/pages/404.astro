---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you were looking for could not be found.">
  <section class="container-x py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold">Page not found</h1>
    <p class="mx-auto mt-4 max-w-md">The page you were looking for has moved or no longer exists.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/services/" class="btn-secondary">View services</a>
    </div>
  </section>
</BaseLayout>
