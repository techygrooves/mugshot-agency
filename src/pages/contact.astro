---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ConsultationForm from '@components/ConsultationForm.astro';
import ConsultationAside from '@components/ConsultationAside.astro';
---
<BaseLayout title="Free Consultation" description="Request a free, confidential reputation consultation with National Reputation Defense. Serving clients in all 50 states.">
  <PageHero
    eyebrow="Contact"
    title="Request a free, confidential consultation"
    lead="Tell us what you are dealing with and we will explain your options honestly. No obligation."
    crumbs={[{ label: 'Free Consultation', href: '/contact/' }]}
  />
  <section class="py-16 md:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-xl shadow-navy-900/5 sm:p-8">
          <h2 class="text-2xl font-bold">Tell us about your situation</h2>
          <p class="mt-2 text-slate-600">It takes about two minutes. Fields marked <span class="text-accent-700">*</span> are required.</p>
          <div class="mt-6"><ConsultationForm id="contact" /></div>
        </div>
      </div>
      <div class="lg:col-span-5"><ConsultationAside /></div>
    </div>
  </section>
</BaseLayout>
