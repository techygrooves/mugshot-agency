---
/** PLACEHOLDER — final text must be prepared or reviewed by counsel before launch. noindex until then. */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
---
<BaseLayout title="Terms of Service" description="The terms that govern use of the National Reputation Defense website and services.">
  <PageHero title="Terms of Service" crumbs={[{ label: 'Terms of Service', href: '/legal/terms/' }]} />
  <section class="py-16">
    <div class="container-x max-w-3xl" data-placeholder="legal-terms">
      <p class="inline-flex rounded-full bg-gold-400/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-800">Being finalized</p>
      <p class="mt-4 text-lg">Our Terms of Service is being finalized and will be published here before we begin accepting client inquiries online.</p>
    </div>
  </section>
</BaseLayout>
