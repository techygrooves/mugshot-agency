---
/** PLACEHOLDER — final text must be prepared or reviewed by counsel before launch. noindex until then. */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
---
<BaseLayout title="Privacy Policy" description="How National Reputation Defense collects, uses and protects your information.">
  <PageHero title="Privacy Policy" crumbs={[{ label: 'Privacy Policy', href: '/legal/privacy/' }]} />
  <section class="py-16">
    <div class="container-x max-w-3xl" data-placeholder="legal-privacy">
      <p class="inline-flex rounded-full bg-gold-400/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-800">Being finalized</p>
      <p class="mt-4 text-lg">Our Privacy Policy is being finalized and will be published here before we begin accepting client inquiries online.</p>
    </div>
  </section>
</BaseLayout>
