---
import { nav, cta } from '@config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
// The contact page is the CTA's destination; repeating the bar there is noise.
const showMobileCta = current !== cta.href;
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
<header class="sticky top-0 z-40 border-b border-navy-100 bg-white/95 backdrop-blur transition-shadow data-[scrolled]:shadow-md data-[scrolled]:shadow-navy-900/5" data-header>
  <div class="container-x flex h-18 items-center justify-between gap-6 py-3">
    <Logo />
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7 whitespace-nowrap text-sm font-medium">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
               class:list={[
                 'relative py-2 transition-colors hover:text-accent-700',
                 'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-accent-600 after:transition-transform',
                 isActive(item.href) ? 'text-accent-700 after:scale-x-100' : 'text-ink after:scale-x-0 hover:after:scale-x-100',
               ]}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={cta.href} class="btn-primary hidden whitespace-nowrap sm:inline-flex">{cta.label}</a>
      <button type="button" class="group rounded-md p-2 text-ink lg:hidden" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
        <Icon name="menu" class="h-6 w-6 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden h-6 w-6 group-aria-expanded:block" />
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-navy-100 bg-white shadow-lg lg:hidden">
    <ul class="container-x flex flex-col divide-y divide-navy-100 py-2">
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
             class:list={['flex items-center justify-between py-3.5 font-medium', isActive(item.href) ? 'text-accent-700' : 'text-ink']}>
            {item.label}<Icon name="arrow" class="h-4 w-4 text-slate-400" />
          </a>
        </li>
      ))}
      <li class="pt-4 pb-3"><a href={cta.href} class="btn-primary w-full">{cta.label}</a></li>
    </ul>
  </nav>
</header>

{showMobileCta && (
  <div class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-navy-100 bg-white/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 data-[visible]:translate-y-0 sm:hidden" data-mobile-cta aria-hidden="true">
    <a href={cta.href} class="btn-primary w-full">{cta.label} <Icon name="arrow" class="h-4 w-4" /></a>
  </div>
)}

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const mobileCta = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu?.classList.toggle('hidden', !open);
    update();
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // The sticky mobile CTA slides in once the visitor scrolls past the first
  // screen (where the page's own CTA sits), and steps aside while the menu is open.
  function update() {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
    if (!mobileCta) return;
    const show = window.scrollY > window.innerHeight * 0.75 && toggle?.getAttribute('aria-expanded') !== 'true';
    mobileCta.toggleAttribute('data-visible', show);
    mobileCta.setAttribute('aria-hidden', String(!show));
    mobileCta.querySelector('a')?.setAttribute('tabindex', show ? '0' : '-1');
  }
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
