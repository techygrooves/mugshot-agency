---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_85%_-10%,rgba(20,184,166,0.22),transparent)]"></div>
  <div class="container-x relative py-16 md:py-20">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    {eyebrow && <p class="eyebrow mt-6 !text-accent-500">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold !text-white md:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{lead}</p>}
    <slot />
  </div>
</section>
