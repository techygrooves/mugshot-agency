---
/**
 * Dark banner at the top of every inner page. On large screens the right
 * column shows the `aside` slot when given (e.g. a key-points card), or a
 * faint brand mark so the banner never looks half-empty.
 */
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_85%_-10%,rgba(20,184,166,0.22),transparent)]"></div>
  {!hasAside && (
    <svg viewBox="0 0 32 36" class="pointer-events-none absolute -right-10 top-1/2 hidden h-[26rem] -translate-y-1/2 text-white/[0.04] lg:block" aria-hidden="true">
      <path d="M16 1 2 6.5v10.2C2 26 8 32.6 16 35c8-2.4 14-9 14-18.3V6.5L16 1Z" fill="none" stroke="currentColor" stroke-width=".5" />
      <path d="M16 4.5 5 8.8v7.9C5 24.3 9.8 29.7 16 31.8c6.2-2.1 11-7.5 11-15.1V8.8L16 4.5Z" fill="currentColor" />
      <path d="m11 18 3.6 3.6L22 14" fill="none" stroke="rgba(20,184,166,.25)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  <div class:list={['container-x relative py-16 md:py-20', hasAside && 'grid items-center gap-10 lg:grid-cols-12']}>
    <div class:list={[hasAside && 'lg:col-span-7']}>
      {crumbs && <Breadcrumbs crumbs={crumbs} />}
      {eyebrow && <p class="eyebrow mt-6 !text-accent-500">{eyebrow}</p>}
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold !text-white md:text-5xl">{title}</h1>
      {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{lead}</p>}
      <slot />
    </div>
    {hasAside && <div class="lg:col-span-5"><slot name="aside" /></div>}
  </div>
</section>
