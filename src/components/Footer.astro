---
import { site, nav } from '@config/site';
import { disclosures } from '@config/compliance';
import { services } from '@data/services';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 text-slate-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo dark />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-slate-400">{site.description}</p>
    </div>
    <div class="md:col-span-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Services</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {services.map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-white">{s.name}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Company</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {nav.filter((n) => n.href !== '/services/').map((n) => <li><a href={n.href} class="hover:text-white">{n.label}</a></li>)}
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Legal</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/legal/disclaimer/" class="hover:text-white">Disclaimer</a></li>
        <li><a href="/legal/privacy/" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/legal/terms/" class="hover:text-white">Terms of Service</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x space-y-3 py-6 text-xs leading-relaxed text-slate-400">
      <p>
        <strong class="text-slate-300">{disclosures.notLawFirm}</strong>{" "}
        Our services are not a substitute for the advice of a licensed attorney. {disclosures.noGuarantee} <a href="/legal/disclaimer/" class="underline hover:text-white">Read the full disclaimer</a>.
      </p>
      <p>&copy; {year} {site.name}. Serving clients in all 50 states.</p>
    </div>
  </div>
</footer>
