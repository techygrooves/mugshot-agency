---
/**
 * Homepage hero illustration: a search-results card in 3D.
 *
 * On load the mugshot result sits at the top of "your name" results, then
 * slides down below the positive results and is struck through as removed —
 * the outcome we work toward, replayed while the card is on screen. The card
 * tilts toward the pointer on desktop.
 *
 * Without JavaScript, or with prefers-reduced-motion, it renders the final
 * state, still. The mock results are aria-hidden; the disclaimer caption is
 * not. No inline styles (CSP): motion is set through the CSSOM in the script.
 */
import Icon from './Icon.astro';

const positives = [
  { host: 'yourname.com', title: 'Your Name — Professional Profile', bar: 'w-4/5', highlight: true },
  { host: 'linkedin.com', title: 'Your Name — Experience & Credentials', bar: 'w-3/5' },
  { host: 'news.example', title: 'Community Award Recognizes Local Leader', bar: 'w-2/3' },
];
---
<figure class="hero-stage" data-hero-stage>
  <div class="hero-float">
    <div class="hero-scene" data-hero-scene>
      <div class="hero-layer hero-layer--far" aria-hidden="true"></div>
      <div class="hero-layer hero-layer--near" aria-hidden="true"></div>

      <div class="hero-card">
        <div class="hero-glare" aria-hidden="true"></div>
        <div aria-hidden="true">
          <div class="hero-search">
            <Icon name="search" class="h-4 w-4 text-accent-700" />
            <span class="text-sm text-slate-500">your name</span>
            <span class="ml-auto hidden rounded-full bg-navy-900 px-3 py-1 text-[11px] font-semibold text-white sm:inline">Search</span>
          </div>
          <ul class="hero-results is-done" data-results>
            {positives.map((r) => (
              <li class:list={['hero-row', r.highlight && 'hero-row--top']} data-row>
                <p class="text-xs text-accent-700">{r.host}</p>
                <p class="font-semibold text-navy-700">{r.title}</p>
                <div class:list={['mt-1.5 h-2 rounded bg-slate-200', r.bar]}></div>
              </li>
            ))}
            <li class="hero-row hero-row--bad" data-row data-bad>
              <p class="text-xs text-slate-500">mugshot-site.example</p>
              <p class="hero-bad-title font-semibold">Arrest Record &amp; Booking Photo</p>
              <span class="hero-badge hero-badge--rank">#1 result</span>
              <span class="hero-badge hero-badge--removed">Removed</span>
            </li>
          </ul>
        </div>
        <figcaption class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">Illustration only. Results vary by situation.</figcaption>
      </div>

      <div class="hero-chip hero-chip--a" aria-hidden="true"><Icon name="check" class="h-4 w-4 text-accent-700" /> Removal request sent</div>
      <div class="hero-chip hero-chip--b" aria-hidden="true"><Icon name="search" class="h-4 w-4 text-accent-700" /> Outdated result refreshed</div>
      <div class="hero-chip hero-chip--c" aria-hidden="true"><Icon name="radar" class="h-4 w-4 text-accent-700" /> Monitoring on</div>
    </div>
  </div>
</figure>

<style>
  .hero-stage {
    perspective: 1600px;
    margin: 0;
  }
  .hero-float {
    transform-style: preserve-3d;
    animation: hero-float 8s ease-in-out infinite;
  }
  .hero-scene {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --glare-x: 30%;
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(calc(4deg + var(--tilt-x))) rotateY(calc(-6deg + var(--tilt-y)));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (min-width: 1024px) {
    .hero-scene {
      transform: rotateX(calc(9deg + var(--tilt-x))) rotateY(calc(-16deg + var(--tilt-y))) rotateZ(1deg);
    }
  }

  /* Stacked "pages" behind the card give it physical depth. */
  .hero-layer {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .hero-layer--near {
    transform: translate3d(22px, 22px, -50px);
    background: linear-gradient(135deg, rgb(20 184 166 / 0.35), rgb(28 58 102 / 0.6));
  }
  .hero-layer--far {
    transform: translate3d(44px, 44px, -100px);
    background: linear-gradient(135deg, rgb(20 184 166 / 0.15), rgb(18 40 74 / 0.5));
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: #fff;
    padding: 1.25rem;
    color: #334155;
    box-shadow:
      0 50px 80px -20px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .hero-glare {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(28rem 20rem at var(--glare-x) 0%, rgb(255 255 255 / 0.7), transparent 60%);
    mix-blend-mode: soft-light;
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    padding: 0.55rem 0.6rem 0.55rem 1rem;
    box-shadow: 0 8px 20px -12px rgb(11 27 51 / 0.35);
  }

  .hero-results {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .hero-row {
    position: relative;
    border-radius: 0.75rem;
    padding: 0.75rem;
    transition:
      background-color 0.5s,
      box-shadow 0.5s,
      opacity 0.5s;
  }
  .hero-row--top {
    background: rgb(213 245 241 / 0.7);
    box-shadow: 0 10px 24px -16px rgb(11 122 117 / 0.6);
  }

  /* The mugshot result: alarming while it ranks, struck out once removed. */
  .hero-row--bad {
    background: #fef2f2;
    box-shadow: 0 12px 28px -14px rgb(185 28 28 / 0.45);
  }
  .hero-bad-title {
    color: #7f1d1d;
    background-image: linear-gradient(#ef4444, #ef4444);
    background-repeat: no-repeat;
    background-position: 0 55%;
    background-size: 0% 2px;
    transition:
      background-size 0.6s ease 0.1s,
      color 0.5s;
  }
  .hero-badge {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition:
      opacity 0.35s,
      transform 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .hero-badge--rank {
    background: #fee2e2;
    color: #991b1b;
  }
  .hero-badge--removed {
    background: #fee2e2;
    color: #991b1b;
    opacity: 0;
    transform: scale(0.6);
  }
  .is-done .hero-row--bad {
    background: #f8fafc;
    box-shadow: none;
  }
  .is-done .hero-bad-title {
    color: #64748b;
    background-size: 100% 2px;
  }
  .is-done .hero-badge--rank {
    opacity: 0;
    transform: scale(0.6);
  }
  .is-done .hero-badge--removed {
    opacity: 1;
    transform: scale(1);
  }

  /* Floating status chips, closer to the viewer than the card. */
  .hero-chip {
    position: absolute;
    display: none;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    border-radius: 9999px;
    background: #fff;
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #0b1b33;
    box-shadow: 0 18px 36px -14px rgb(0 0 0 / 0.55);
    animation: hero-chip 6s ease-in-out infinite;
  }
  @media (min-width: 640px) {
    .hero-chip {
      display: inline-flex;
    }
  }
  .hero-chip--a {
    left: -1.75rem;
    top: 5.5rem;
    transform: translateZ(90px);
  }
  .hero-chip--b {
    right: 1.5rem;
    bottom: -1.4rem;
    transform: translateZ(120px);
    animation-delay: -2s;
  }
  .hero-chip--c {
    right: 2rem;
    top: -1.1rem;
    transform: translateZ(70px);
    animation-delay: -4s;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes hero-chip {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float,
    .hero-chip {
      animation: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const stage of document.querySelectorAll<HTMLElement>('[data-hero-stage]')) {
    const scene = stage.querySelector<HTMLElement>('[data-hero-scene]')!;
    const list = stage.querySelector<HTMLElement>('[data-results]')!;
    const rows = [...list.querySelectorAll<HTMLElement>('[data-row]')];
    const bad = list.querySelector<HTMLElement>('[data-bad]')!;
    const others = rows.filter((r) => r !== bad);

    // Pointer tilt (desktop, fine pointers only).
    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      stage.addEventListener('pointermove', (e) => {
        const box = stage.getBoundingClientRect();
        const x = (e.clientX - box.left) / box.width - 0.5;
        const y = (e.clientY - box.top) / box.height - 0.5;
        scene.style.setProperty('--tilt-y', `${(x * 12).toFixed(2)}deg`);
        scene.style.setProperty('--tilt-x', `${(-y * 10).toFixed(2)}deg`);
        scene.style.setProperty('--glare-x', `${Math.round((x + 0.5) * 100)}%`);
      });
      stage.addEventListener('pointerleave', () => {
        scene.style.setProperty('--tilt-y', '0deg');
        scene.style.setProperty('--tilt-x', '0deg');
        scene.style.setProperty('--glare-x', '30%');
      });
    }

    if (reduceMotion) continue;

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const frame = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
    const gap = () => parseFloat(getComputedStyle(list).rowGap) || 0;

    /** Puts the mugshot result visually first, with no transition. */
    function rankBadFirst() {
      const g = gap();
      const othersHeight = others.reduce((sum, r) => sum + r.offsetHeight + g, 0);
      for (const r of rows) r.style.transition = 'none';
      bad.style.transform = `translateY(${-othersHeight}px)`;
      for (const r of others) r.style.transform = `translateY(${bad.offsetHeight + g}px)`;
      list.classList.remove('is-done');
    }

    /** Slides every result into its final place, then marks the mugshot removed. */
    async function slideIntoPlace() {
      for (const r of rows) {
        r.style.transition = 'transform 1.1s cubic-bezier(0.65, 0, 0.25, 1), background-color 0.5s, box-shadow 0.5s';
        r.style.transform = '';
      }
      await wait(1000);
      list.classList.add('is-done');
    }

    let playing = false;
    let visible = false;

    async function play() {
      if (playing) return;
      playing = true;
      while (visible) {
        rankBadFirst();
        await frame();
        await wait(1400);
        await slideIntoPlace();
        await wait(4200);
      }
      playing = false;
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) play();
    }, { threshold: 0.4 }).observe(stage);
  }
</script>
