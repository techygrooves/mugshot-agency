---
import { site } from '@config/site';
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---
<a href="/" class="group inline-flex items-center gap-2.5" aria-label={`${site.name} — home`}>
  <svg viewBox="0 0 32 36" class="h-9 w-8 shrink-0" aria-hidden="true">
    <path d="M16 1 2 6.5v10.2C2 26 8 32.6 16 35c8-2.4 14-9 14-18.3V6.5L16 1Z" fill={dark ? '#14b8a6' : '#0b1b33'} />
    <path d="M16 6.2 7 9.8v6.9c0 6.1 3.8 10.6 9 12.4V6.2Z" fill={dark ? '#0b1b33' : '#14b8a6'} opacity=".9" />
    <path d="m11 18 3.6 3.6L22 14" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="leading-none">
    <span class:list={['block font-display text-[15px] font-extrabold uppercase tracking-[0.08em]', dark ? 'text-white' : 'text-ink']}>National Reputation</span>
    <span class:list={['mt-1 block text-[11px] font-semibold uppercase tracking-[0.42em]', dark ? 'text-accent-500' : 'text-accent-700']}>Defense</span>
  </span>
</a>
