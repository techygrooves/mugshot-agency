---
/**
 * Service card. On phones it is a compact row (icon beside text) so six
 * services don't become a 1,500px scroll; from `sm` up it is a tall card.
 */
import type { Service } from '@data/services';
import Icon from './Icon.astro';
interface Props {
  service: Service;
}
const { service } = Astro.props;
---
<a href={`/services/${service.slug}/`} class="group flex h-full gap-4 rounded-2xl border border-navy-100 bg-white p-5 transition hover:border-accent-500 hover:shadow-lg hover:shadow-navy-900/5 motion-safe:hover:-translate-y-0.5 sm:flex-col sm:gap-0 sm:p-7">
  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent-100 text-accent-700 sm:h-12 sm:w-12">
    <Icon name={service.icon} />
  </span>
  <div class="flex flex-1 flex-col">
    <div class="flex items-start justify-between gap-3 sm:mt-5">
      <h3 class="text-base font-bold sm:text-lg">{service.name}</h3>
      <Icon name="arrow" class="mt-0.5 h-5 w-5 shrink-0 text-accent-700 sm:hidden" />
    </div>
    <p class="mt-1.5 flex-1 text-sm leading-relaxed sm:mt-2 sm:text-[15px]">{service.summary}</p>
    <span class="mt-5 hidden items-center gap-1.5 text-sm font-semibold text-accent-700 sm:inline-flex">
      Learn more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
