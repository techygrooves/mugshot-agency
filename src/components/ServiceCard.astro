---
import type { Service } from '@data/services';
import Icon from './Icon.astro';
interface Props {
  service: Service;
}
const { service } = Astro.props;
---
<a href={`/services/${service.slug}/`} class="group flex h-full flex-col rounded-2xl border border-navy-100 bg-white p-7 transition hover:-translate-y-0.5 hover:border-accent-500 hover:shadow-lg hover:shadow-navy-900/5">
  <span class="grid h-12 w-12 place-items-center rounded-xl bg-accent-100 text-accent-700">
    <Icon name={service.icon} />
  </span>
  <h3 class="mt-5 text-lg font-bold">{service.name}</h3>
  <p class="mt-2 flex-1 text-[15px] leading-relaxed">{service.summary}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700">
    Learn more <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
